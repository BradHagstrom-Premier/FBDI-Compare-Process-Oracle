<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>FBDI Compliance Report — {{ ctx.old_release }} → {{ ctx.new_release }}</title>
<style>
  /* === Bundled fonts — Inter (sans) + JetBrains Mono (mono).
         Both OFL-licensed; files in fonts/ alongside this template.
         Variable fonts; weasyprint resolves via base_url passed by report.py.
         Only emitted in print_mode: when consumed as HTML in a browser, the
         relative path won't resolve from wherever the file is opened, and
         the system-font fallback stack already covers screen rendering. === */
  {% if print_mode %}
  @font-face {
    font-family: 'Inter';
    src: url('fonts/InterVariable.ttf') format('truetype-variations');
    font-weight: 100 900;
    font-style: normal;
  }
  @font-face {
    font-family: 'JetBrains Mono';
    src: url('fonts/JetBrainsMono.ttf') format('truetype-variations');
    font-weight: 100 900;
    font-style: normal;
  }
  {% endif %}

  /* === Design system tokens — palette, type, spacing, radius === */
  :root {
    /* Palette: Definian Signal — strict; do not introduce off-palette colors */
    --def-blue: #0D2C71;      /* Authority Blue — structural backbone */
    --def-green: #00AB63;     /* Signal Green — additions, Financials, brand */
    --midnight: #02072D;      /* Near-Black Midnight — primary text */
    --darkgray: #3C405B;      /* Slate Annotation — supporting text */
    --coolgray: #D8D7EE;      /* Mist Divider — borders, structural lines */
    --bg-soft: #F7F7FB;       /* Cloud Surface — card backgrounds */
    --canvas: #FFFFFF;        /* Canvas — document ground */
    --warn: #B8860B;          /* Caution Amber — modified fields */
    --warn-bg: #FFFBF0;       /* Caution tint */
    --del: #C0392B;           /* Remove Red — removed fields */
    --success-bg: oklch(97% 0.025 155); /* Complete state tint — progress meter only */
    --row-hover: rgba(13, 44, 113, 0.025);
    --action-tint: rgba(13, 44, 113, 0.03);
    --cell-border: rgba(13, 44, 113, 0.06);

    /* Type scale (DESIGN.md) — six steps, no in-betweens */
    --type-display:  36px;
    --type-headline: 22px;
    --type-title:    18px;
    --type-body:     13px;
    --type-label:    10.5px;
    --type-mono:     11.5px;

    /* Weight */
    --weight-regular:  400;
    --weight-semibold: 600;
    --weight-bold:     700;
    --weight-black:    800;

    /* Letter-spacing */
    --track-display: -0.5px;
    --track-label:    0.5px;
    --track-brand:    3px;     /* cover wordmark only */

    /* Spacing scale (DESIGN.md) — five steps */
    --space-xs:  4px;
    --space-sm:  8px;
    --space-md:  14px;
    --space-lg:  22px;
    --space-xl:  36px;

    /* Radius (DESIGN.md) */
    --radius-xs:   2px;
    --radius-sm:   4px;
    --radius-md:   6px;
    --radius-pill: 12px;

    /* Tint scale — used as opacity for layered text/glyphs against tinted backgrounds.
       Three steps; pick the step, don't hand-tune each call site. */
    --tint-strong: 0.92;
    --tint-mid:    0.7;
    --tint-faint:  0.45;

    /* Motion — single duration for HTML interactivity. PDF doesn't animate. */
    --motion-fast: 0.15s;
  }

  /* === Base typography === */
  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--midnight);
    margin: 0;
    background: var(--canvas);
  }
  /* Mono Rule (DESIGN.md): every <code> element is a technical identifier — render mono. */
  code {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
  }

  /* === Cover === */
  .cover {
    background: linear-gradient(135deg, var(--def-blue) 0%, var(--midnight) 100%);
    color: var(--canvas);
    padding: var(--space-xl);
    text-align: center;
  }
  .cover .brand {
    font-size: var(--type-label);
    letter-spacing: var(--track-brand);
    color: var(--def-green);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }
  .cover h1 {
    font-size: var(--type-display);
    margin: 0 0 var(--space-md);
    font-weight: var(--weight-black);
    letter-spacing: var(--track-display);
  }
  .cover .sub {
    font-size: var(--type-body);
    opacity: var(--tint-strong);
    margin-bottom: var(--space-lg);
    font-weight: var(--weight-regular);
  }
  .cover .meta {
    display: inline-flex;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    font-size: var(--type-body);
  }
  .cover .meta b {
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-size: var(--type-label);
    font-weight: var(--weight-semibold);
    opacity: var(--tint-faint);
  }

  /* === Section base === */
  .section {
    padding: var(--space-lg) var(--space-xl);
    border-top: 1px solid var(--coolgray);
  }
  .section h2 {
    color: var(--def-blue);
    font-size: var(--type-headline);
    margin: 0 0 var(--space-xs);
    font-weight: var(--weight-bold);
    /* PDF outline: top-level bookmarks for §1, §2, §3. */
    bookmark-level: 1;
    bookmark-label: content(text);
  }
  .section .lede {
    color: var(--darkgray);
    font-size: var(--type-body);
    margin-bottom: var(--space-lg);
  }

  /* === Progress meter (HTML only) — sits in §1 header area, updates live === */
  .progress-meter {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-left: var(--space-md);
    padding: var(--space-xs) var(--space-md);
    background: var(--bg-soft);
    border: 1px solid var(--coolgray);
    border-radius: var(--radius-pill);
    font-size: var(--type-label);
    vertical-align: middle;
  }
  .progress-meter-eyebrow {
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-weight: var(--weight-semibold);
    color: var(--darkgray);
  }
  .progress-meter-count {
    font-weight: var(--weight-bold);
    color: var(--midnight);
    font-variant-numeric: tabular-nums;
  }
  .progress-meter-bar {
    width: 80px;
    height: 4px;
    background: var(--coolgray);
    border-radius: 2px;
    overflow: hidden;
  }
  .progress-meter-fill {
    height: 100%;
    background: var(--def-green);
    width: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.2s ease-out;
  }
  .progress-meter-pct {
    color: var(--darkgray);
    font-variant-numeric: tabular-nums;
  }
  .progress-meter-local {
    color: var(--darkgray);
    opacity: var(--tint-faint);
    font-size: 9px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    align-self: center;
  }
  .progress-meter.complete { border-color: var(--def-green); background: var(--success-bg); }
  .progress-meter.complete .progress-meter-fill { background: var(--def-green); }
  .progress-meter.complete .progress-meter-eyebrow::after { content: ' \2713'; color: var(--def-green); }

  /* === Module quick-jump (HTML nav above §2 module groups) === */
  .module-jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
  }
  .module-jump-eyebrow {
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-weight: var(--weight-semibold);
    font-size: var(--type-label);
    color: var(--darkgray);
    align-self: center;
    margin-right: var(--space-xs);
  }
  .module-jump a {
    display: inline-block;
    padding: 2px var(--space-sm);
    border: 1px solid var(--coolgray);
    border-radius: var(--radius-pill);
    background: var(--canvas);
    color: var(--midnight);
    font-size: var(--type-label);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  /* === Module group (structural landmark for §2) === */
  .module-group { margin-bottom: var(--space-xl); }
  .module-group:last-child { margin-bottom: 0; }
  .module-header {
    margin: 0 0 var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--def-blue);
  }
  .module-eyebrow {
    display: block;
    font-size: var(--type-label);
    font-weight: var(--weight-semibold);
    color: var(--darkgray);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    margin-bottom: var(--space-xs);
  }
  .module-name {
    font-size: var(--type-title);
    font-weight: var(--weight-bold);
    color: var(--def-blue);
    margin: 0;
    line-height: 1.2;
    /* PDF outline: module groups nest under §2. */
    bookmark-level: 2;
    bookmark-label: content(text);
  }

  /* === Summary table === */
  .summary-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--type-body);
  }
  .summary-table th {
    background: var(--def-blue);
    color: var(--canvas);
    padding: var(--space-sm);
    text-align: left;
    font-weight: var(--weight-semibold);
    font-size: var(--type-label);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
  }
  .summary-table th.num { text-align: right; }
  .summary-table td {
    padding: var(--space-sm);
    border-bottom: 1px solid var(--coolgray);
  }
  .summary-table td.num {
    text-align: right;
    width: 1%;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  /* Semantic count cells: non-zero counts adopt the legend's color so the
     at-a-glance scan column carries signal, not just numbers. Zeros fade to
     Mist so they recede visually. */
  .summary-table td.num.zero { color: var(--coolgray); }
  .summary-table td.num.add   { color: var(--def-green); font-weight: var(--weight-bold); }
  .summary-table td.num.rem   { color: var(--del);       font-weight: var(--weight-bold); }
  .summary-table td.num.mod   { color: var(--warn);      font-weight: var(--weight-bold); }
  .summary-table td.num.shift { color: var(--darkgray);  font-weight: var(--weight-bold); }
  /* Summary-table technical-identifier cells (FBDI file/tab, Applaud table) — mono per Mono Rule. */
  .summary-table td.tech {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: var(--type-mono);
  }
  .summary-table td.tech b { font-weight: var(--weight-bold); }
  .summary-table td.tech .sub {
    display: block;
    margin-top: 2px;
    font-size: var(--type-label);
    color: var(--darkgray);
    font-weight: var(--weight-regular);
  }
  /* Summary-table file links: jump to the matching file-section. Inherit color
     (no default browser blue), no underline by default; underline on hover for HTML. */
  .summary-table td.tech a {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .summary-table td.tech a::after {
    content: ' \2192';
    font-family: sans-serif;
    color: var(--coolgray);
    font-weight: var(--weight-regular);
  }
  /* Module tag — neutral for every module, including Financials. Signal Green
     is reserved for ADDED counts and the cover wordmark; using it as a module
     decoration would dilute that semantic. The module's name does the
     differentiation; color does not. */
  .module-tag {
    display: inline-block;
    padding: 1px var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--coolgray);
    color: var(--midnight);
    font-size: var(--type-label);
    font-weight: var(--weight-semibold);
  }

  /* === Per-file section === */
  .file-section {
    border: 1px solid var(--coolgray);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-md);
  }
  .file-head {
    background: var(--def-blue);
    color: var(--canvas);
    padding: var(--space-md);
    /* file-head fills the top of the file-section, so it carries the
       top corner radius directly (no overflow:hidden trick on the parent). */
    border-top-left-radius: var(--radius-md);
    border-top-right-radius: var(--radius-md);
  }
  .file-head .file-name {
    /* Filename is a technical identifier — mono per DESIGN.md Mono Rule.
       Tighter tracking compensates for mono's wider glyphs at title scale. */
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: var(--type-title);
    margin: 0 0 var(--space-xs);
    font-weight: var(--weight-bold);
    line-height: 1.2;
    letter-spacing: -0.3px;
    /* PDF outline: per-file bookmarks nest under each module. */
    bookmark-level: 3;
    bookmark-label: content(text);
    /* PDF running header: weasyprint captures the latest file-name into
       --running-file, which the @page @top-left margin box pulls in. So a
       file-section spanning pages shows its file name on continuation pages. */
    string-set: running-file content(text);
  }
  .file-head .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--type-body);
    opacity: var(--tint-strong);
  }
  .file-head code {
    background: rgba(255, 255, 255, 0.15);
    padding: 1px var(--space-xs);
    border-radius: var(--radius-xs);
    font-size: var(--type-label);
  }
  .file-body {
    padding: var(--space-md) var(--space-lg);
    background: var(--canvas);
  }

  .in-base-note {
    background: var(--warn-bg);
    border: 1px solid var(--warn);
    color: var(--warn);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-xs);
    font-size: var(--type-body);
    margin-bottom: var(--space-md);
  }

  /* === Change blocks === */
  .change-block { margin-bottom: var(--space-md); }
  .change-block:last-child { margin-bottom: 0; }
  .change-block h4 {
    font-size: var(--type-body);
    margin: 0 0 var(--space-sm);
    color: var(--def-blue);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-weight: var(--weight-bold);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .change-block h4 .count {
    background: var(--def-green);
    color: var(--canvas);
    border-radius: var(--radius-pill);
    padding: 1px var(--space-sm);
    font-size: var(--type-label);
    letter-spacing: 0;
  }
  .change-block.removed h4 { color: var(--del); }
  .change-block.removed h4 .count { background: var(--del); }
  .change-block.modified h4 { color: var(--warn); }
  .change-block.modified h4 .count { background: var(--warn); }
  .change-block.renamed h4 { color: var(--darkgray); }
  .change-block.renamed h4 .count { background: var(--darkgray); }
  .change-block.shifted h4 { color: var(--darkgray); }
  .change-block.shifted h4 .count { background: var(--darkgray); }

  .ct {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--type-body);
  }
  .ct th {
    background: var(--coolgray);
    color: var(--midnight);
    padding: var(--space-sm);
    text-align: left;
    font-weight: var(--weight-semibold);
    font-size: var(--type-label);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    border-bottom: 1px solid var(--coolgray);
  }
  .ct th.num {
    text-align: right;
    padding-right: var(--space-md);
  }
  .ct td {
    padding: var(--space-sm);
    border-bottom: 1px solid var(--cell-border);
    vertical-align: middle;
  }
  .ct td.num {
    text-align: right;
    width: 1%;
    white-space: nowrap;
    padding-right: var(--space-md);
    color: var(--darkgray);
    font-variant-numeric: tabular-nums;
  }
  .ct td.field {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: var(--type-mono);
    white-space: nowrap;
  }
  .ct .center { text-align: center; }
  .ct th.action-col,
  .ct td.action-col {
    text-align: center;
    width: 56px;
    background: var(--action-tint);
    border-left: 1px solid var(--cell-border);
  }
  .ct td.action-col.dim { background: var(--bg-soft); }
  .ct .dash-cell {
    text-align: center;
    color: var(--coolgray);
  }
  /* PDF-only action indicators (colored dot signals action type) */
  .pdf-action {
    font-size: var(--type-label);
    line-height: 1;
    color: var(--def-blue);
    display: inline-block;
  }
  .pdf-action.pdf-del   { color: var(--del); }
  .pdf-action.pdf-warn  { color: var(--warn); }
  .pdf-action.pdf-shift { color: var(--darkgray); }
  .pdf-action.pdf-dash  { color: var(--darkgray); opacity: var(--tint-faint); }
  .ct .badge {
    display: inline-block;
    padding: 1px var(--space-xs);
    border-radius: var(--radius-pill);
    font-size: var(--type-label);
    font-weight: var(--weight-semibold);
  }
  .ct .badge.warn-text {
    background: var(--warn-bg);
    color: var(--warn);
    border: 1px solid var(--warn);
  }
  .type-arrow {
    color: var(--darkgray);
    padding: 0 var(--space-xs);
  }
  .type-old {
    color: var(--darkgray);
    text-decoration: line-through;
    opacity: var(--tint-mid);
  }
  .type-new {
    color: var(--midnight);
    font-weight: var(--weight-semibold);
  }
  .renamed-note {
    font-size: var(--type-label);
    color: var(--darkgray);
    margin-top: var(--space-xs);
    font-style: italic;
  }
  .required-note {
    background: var(--warn-bg);
    border: 1px solid var(--warn);
    color: var(--warn);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-xs);
    font-size: var(--type-body);
    margin-bottom: var(--space-md);
  }

  /* === Shift summary + collapsible === */
  .summary-box {
    background: var(--bg-soft);
    border: 1px solid var(--coolgray);
    padding: var(--space-sm) var(--space-md);
    font-size: var(--type-body);
    color: var(--darkgray);
    margin-bottom: var(--space-sm);
  }
  details.shift-details {
    border: 1px solid var(--coolgray);
    border-radius: var(--radius-sm);
    margin-top: var(--space-sm);
  }
  details.shift-details > summary {
    padding: var(--space-sm) var(--space-md);
    cursor: pointer;
    background: var(--bg-soft);
    font-size: var(--type-body);
    color: var(--def-blue);
    font-weight: var(--weight-semibold);
    list-style: none;
    transition: background var(--motion-fast) ease-out;
  }
  details.shift-details > summary::before {
    content: '\25B6';
    margin-right: var(--space-xs);
    transition: transform var(--motion-fast) ease-out;
    display: inline-block;
    font-size: var(--type-label);
  }
  details.shift-details[open] > summary::before { transform: rotate(90deg); }
  details.shift-details > div {
    padding: var(--space-sm) var(--space-md);
    border-top: 1px solid var(--coolgray);
  }
  .shift-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs) var(--space-lg);
    font-size: var(--type-body);
  }
  .shift-grid .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-xs) var(--space-sm);
    border-bottom: 1px solid var(--cell-border);
  }
  .shift-grid .field-name {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: var(--type-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .shift-grid .pos-pair { white-space: nowrap; }
  .shift-grid .arrow { color: var(--darkgray); }
  .shift-grid .new-pos {
    color: var(--midnight);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }
  .shift-grid .old-pos {
    color: var(--darkgray);
    font-variant-numeric: tabular-nums;
  }

  /* === Legend strip (placed at top of §2) === */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-soft);
    border: 1px solid var(--coolgray);
    border-radius: var(--radius-sm);
    font-size: var(--type-label);
    margin-bottom: var(--space-lg);
  }
  .legend-eyebrow {
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-weight: var(--weight-semibold);
    color: var(--darkgray);
  }
  .legend-item {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-xs);
    color: var(--darkgray);
  }
  .legend-item b {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
    font-weight: var(--weight-bold);
    color: var(--midnight);
    font-size: var(--type-label);
  }
  .legend-divider {
    width: 1px;
    height: 12px;
    background: var(--coolgray);
  }

  /* === Needs-review badge === */
  .needs-review-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 1px var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--warn-bg);
    border: 1px solid var(--warn);
    color: var(--warn);
    font-size: var(--type-label);
    font-weight: var(--weight-semibold);
    vertical-align: middle;
    white-space: nowrap;
  }

  /* === Pending base list === */
  .pending-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pending-list li {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--coolgray);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-xs);
    background: var(--bg-soft);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--type-body);
  }
  .pending-list .file-id {
    /* Inherits mono via the global `code` rule. Kept bold; color stays Midnight
       (inherited) so the file-id reads consistently with the summary-table file-ids
       rather than as a colored heading. */
    font-weight: var(--weight-bold);
  }
  .pending-list .name .module-tag { margin-left: var(--space-xs); }
  .pending-list .pending-count {
    color: var(--darkgray);
    font-size: var(--type-label);
  }
  .pending-footnote {
    font-size: var(--type-label);
    color: var(--darkgray);
    margin-top: var(--space-sm);
    font-style: italic;
  }

  /* === Two-media boundary ===
     The HTML and PDF outputs share this template but diverge through TWO mechanisms,
     each carrying responsibility for a different kind of difference:

       1. The Jinja `print_mode` flag swaps DOM elements that are categorically
          different between media — interactive checkboxes vs. printed dot indicators,
          collapsible <details> vs. always-expanded shift-grids.
       2. The `@media print` block (below) overrides layout/styling — paddings,
          page rules, font sizing, table widths.

     A consumer printing the HTML directly from a browser triggers `@media print`
     but NOT `print_mode` (which is server-side Jinja). The `@media print` rules
     therefore include guards that make the printed HTML still legible — primarily
     hiding the interactive checkboxes that wouldn't make sense on paper. */

  /* === HTML-only interactive states === */
  @media screen {
    /* Sticky summary thead so column headers stay visible while scrolling §1 list. */
    .summary-table thead th { position: sticky; top: 0; z-index: 1; }
    .summary-table td.tech a:hover { text-decoration: underline; color: var(--def-blue); }
    .summary-table td.tech a:hover::after { color: var(--def-blue); }
    .summary-table tbody tr:hover { background: var(--row-hover); cursor: pointer; }
    .module-jump a:hover { background: var(--bg-soft); border-color: var(--def-blue); }
    .ct tbody tr:hover td { background: var(--row-hover); }
    .ct tbody tr:hover td.action-col { background: var(--action-tint); }
    details.shift-details > summary { user-select: none; }
    details.shift-details > summary:hover { background: var(--coolgray); }
    details.shift-details > summary::-webkit-details-marker { display: none; }
    /* Sticky progress meter — fixed to bottom-right so it stays visible while scrolling. */
    .progress-meter {
      position: fixed;
      bottom: var(--space-lg);
      right: var(--space-lg);
      margin-left: 0;
      z-index: 100;
    }
    /* Change-type filter bar (HTML only) */
    .change-filter {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-sm);
      padding: var(--space-sm) var(--space-md);
      background: var(--canvas);
      border: 1px solid var(--coolgray);
      border-radius: var(--radius-sm);
      font-size: var(--type-label);
      margin-bottom: var(--space-md);
    }
    .change-filter-eyebrow {
      text-transform: uppercase;
      letter-spacing: var(--track-label);
      font-weight: var(--weight-semibold);
      color: var(--darkgray);
    }
    .change-filter-option {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
      cursor: pointer;
      padding: 2px var(--space-sm);
      border-radius: var(--radius-pill);
      border: 1px solid var(--coolgray);
      background: var(--canvas);
      user-select: none;
      transition: background var(--motion-fast) ease-out, border-color var(--motion-fast) ease-out;
    }
    .change-filter-option:has(input:checked) { background: var(--bg-soft); }
    .cf-check { cursor: pointer; accent-color: var(--def-blue); }
    .cf-label { font-weight: var(--weight-semibold); }
    .cf-label.added   { color: var(--def-green); }
    .cf-label.removed { color: var(--del); }
    .cf-label.modified { color: var(--warn); }
    .cf-label.shifted  { color: var(--darkgray); }
    /* Sticky controls — legend + filter bar stack as one pinned band. */
    .sticky-controls {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--canvas);
      border-bottom: 1px solid var(--coolgray);
      margin-bottom: var(--space-md);
    }
    .sticky-controls .legend { margin-bottom: 0; border-bottom: none; border-radius: 0; border-left: none; border-right: none; border-top: none; }
    .sticky-controls .change-filter { margin-bottom: 0; border-bottom: none; border-radius: 0; border-left: none; border-right: none; }
    /* Export state link — HTML-only, progress meter companion. */
    .export-state-link {
      font-size: 9px;
      color: var(--darkgray);
      opacity: 0.7;
      text-decoration: none;
      letter-spacing: 0.3px;
      text-transform: uppercase;
    }
    .export-state-link:hover { opacity: 1; text-decoration: underline; }
    /* Module jump focus ring. */
    .module-jump a:focus-visible { outline: 2px solid var(--def-blue); outline-offset: 2px; border-radius: var(--radius-pill); }
    /* Interactive checkboxes — template-internal component, fixed pixel art.
       The 16/4/1/5/8px values and 1.5px borders aren't on the DESIGN.md spacing
       scale because this is a custom-rendered control (appearance: none + a
       hand-drawn checkmark via a rotated bordered box). Treating it as a
       template-local component rather than a token-scale element. If a second
       custom control ever ships, upstream these into DESIGN.md as a `checkbox`
       component spec. */
    input.action-check {
      appearance: none;
      -webkit-appearance: none;
      width: 16px;
      height: 16px;
      border: 1.5px solid var(--def-blue);
      border-radius: var(--radius-xs);
      cursor: pointer;
      vertical-align: middle;
      margin: 0;
      display: inline-block;
      position: relative;
      transition: background var(--motion-fast) ease-out, border-color var(--motion-fast) ease-out;
    }
    input.action-check::after {
      content: '';
      position: absolute;
      display: none;
      left: 4px;
      top: 1px;
      width: 5px;
      height: 8px;
      border: 1.5px solid var(--canvas);
      border-top: none;
      border-left: none;
      transform: rotate(45deg);
    }
    input.action-check:checked { background: var(--def-blue); }
    input.action-check:checked::after { display: block; }
    input.action-check:hover { border-width: 2px; }
    input.action-check.del { border-color: var(--del); }
    input.action-check.del:checked { background: var(--del); }
    input.action-check.warn { border-color: var(--warn); }
    input.action-check.warn:checked { background: var(--warn); }
    input.action-check.dash { border-style: dashed; opacity: var(--tint-faint); }
    input.action-check.dash:checked { opacity: 1; border-style: solid; }
    /* Summary table horizontal scroll */
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  }

  /* === Print mode (PDF) === */
  @media print {
    /* Default page: A4, comfortable margins. Running header (top-left) carries
       the current file-section name so continuation pages keep their anchor;
       running footer (bottom-right) carries release pair + page numbers. */
    @page {
      margin: 2cm 2cm 2cm;
      size: A4;
      @top-left {
        content: string(running-file);
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: var(--type-label);
        font-weight: var(--weight-bold);
        color: var(--darkgray);
        letter-spacing: -0.2px;
      }
      @bottom-right {
        /* Two spaces after each hex escape: first terminates the escape, second is literal */
        content: "{{ ctx.old_release }}  \2192  {{ ctx.new_release }}  \00B7  Page " counter(page) " of " counter(pages);
        font-family: 'Inter', sans-serif;
        font-size: var(--type-label);
        color: var(--darkgray);
        letter-spacing: var(--track-label);
      }
    }
    /* Cover page bleeds to the edge — the document's one creative moment.
       Suppress both running header and footer on the cover. */
    @page :first {
      margin: 0;
      @top-left { content: ""; }
      @bottom-right { content: ""; }
    }
    .cover { padding: var(--space-xl); }
    .section { padding: var(--space-md) var(--space-lg); }
    .file-body { padding: var(--space-sm) var(--space-md); }
    .ct td, .ct th { padding: var(--space-xs) var(--space-sm); }
    .table-scroll { overflow: visible; }
    /* Explicit cm widths summing to ~16.5cm (page content is 17cm with 2cm side
       margins) — avoids a weasyprint quirk that clips the last column when
       table-layout: fixed widths sum to exactly 100% alongside @page margin boxes. */
    .summary-table { table-layout: fixed; width: 100%; font-size: var(--type-label); }
    .summary-table th:nth-child(1) { width: 3.6cm; }
    .summary-table th:nth-child(2) { width: 2.8cm; }
    .summary-table th:nth-child(3) { width: 1.0cm; }
    .summary-table th:nth-child(4) { width: 2.6cm; }
    .summary-table th:nth-child(5),
    .summary-table th:nth-child(6),
    .summary-table th:nth-child(7),
    .summary-table th:nth-child(8) { width: 1.6cm; }
    .summary-table td, .summary-table th { padding: var(--space-xs); overflow: hidden; overflow-wrap: break-word; }
    /* Shift-grid: single column in print so long mono field names + position pair stay on one row */
    .shift-grid { grid-template-columns: 1fr; gap: 2px 0; }
    h2, h3, h4 { page-break-after: avoid; }
    thead { display: table-header-group; }
    /* Page-break discipline:
       - Headings stay with their content (page-break-after: avoid above).
       - Individual table rows are atomic — never split a row mid-cell.
       - Change-blocks DO flow across pages: with .change-block { avoid },
         a future release shipping 50+ ADDED rows in one block would push
         the entire block to a new page (and overflow if it's >1 page tall).
         Without avoid, the block flows; thead repeats via table-header-group;
         consultants see column headers on every continuation page. */
    .ct tr { page-break-inside: avoid; }
    .ct thead tr { page-break-after: avoid; }
    .ct tbody tr:hover td { background: inherit; }
    /* Browser-print guard: if HTML is printed directly (not via weasyprint),
       hide the interactive checkbox so action cells don't show empty boxes. */
    input.action-check { display: none; }
  }
</style>
</head>
<body>

<!-- Cover -->
<div class="cover">
  <div class="brand">DEFINIAN · Applaud Base System</div>
  <h1>FBDI Compliance Report</h1>
  <div class="sub">Required changes between Oracle Cloud releases</div>
  <div class="meta">
    <span><b>From</b> Release {{ ctx.old_release }}</span>
    <span><b>To</b> Release {{ ctx.new_release }}</span>
    <span><b>Generated</b> {{ ctx.generated_date }}</span>
  </div>
</div>

<!-- Section 1: Summary table -->
<div class="section">
  <h2>1. Summary by FBDI tab{% if not print_mode %}<span class="progress-meter" id="progress-meter" title="Action state saved in this browser only. Use Export to share or preserve across machines.">
    <span class="progress-meter-eyebrow">Progress</span>
    <span class="progress-meter-count"><span id="progress-done">0</span>&thinsp;/&thinsp;<span id="progress-total">0</span></span>
    <span class="progress-meter-bar"><span class="progress-meter-fill" id="progress-fill"></span></span>
    <span class="progress-meter-pct"><span id="progress-pct">0</span>%</span>
    <span class="progress-meter-local">this browser</span>
    <a id="export-state-link" href="#" class="export-state-link" title="Download action state as JSON" aria-label="Export action state as JSON">Export</a>
  </span>{% endif %}</h2>
  <div class="lede">{{ ctx.file_sections | length }} mapped tab{% if ctx.file_sections | length != 1 %}s{% endif %} have changes between {{ ctx.old_release }} and {{ ctx.new_release }}. UNMAPPED files are excluded; pending base-system tables are listed at the end.</div>
  <div class="table-scroll">
  <table class="summary-table">
    <thead>
      <tr>
        <th scope="col">FBDI File · Tab</th>
        <th scope="col">Applaud Table</th>
        <th scope="col">Prefix</th>
        <th scope="col">Module</th>
        <th class="num" scope="col">Add</th>
        <th class="num" scope="col">Rem</th>
        <th class="num" scope="col">Mod</th>
        <th class="num" scope="col">Shift</th>
      </tr>
    </thead>
    {% set totals = namespace(add=0, rem=0, mod=0, shift=0) %}
    <tbody>
      {% for s in ctx.file_sections %}
      {% set added_n   = s.changes_by_type.get('ADDED', [])    | length %}
      {% set removed_n = s.changes_by_type.get('REMOVED', [])  | length %}
      {% set mod_n     = (s.changes_by_type.get('MODIFIED', []) | length) + (s.changes_by_type.get('MULTI', []) | length) %}
      {% set shift_n   = s.changes_by_type.get('SHIFTED', [])  | length %}
      {% set totals.add   = totals.add   + added_n %}
      {% set totals.rem   = totals.rem   + removed_n %}
      {% set totals.mod   = totals.mod   + mod_n %}
      {% set totals.shift = totals.shift + shift_n %}
      <tr>
        <td class="tech"><a href="#file-{{ s.file }}-{{ s.prefix }}"><b>{{ s.file }}</b><span class="sub">{{ s.tab }}</span></a></td>
        <td class="tech">{{ s.applaud_table }}{% if s.status == 'NEEDS_REVIEW' %} <span class="needs-review-badge">&#9888; Needs review</span>{% endif %}</td>
        <td><code>{{ s.prefix }}</code></td>
        <td><span class="module-tag">{{ s.module }}</span></td>
        <td class="num {{ 'add'   if added_n   else 'zero' }}">{{ added_n }}</td>
        <td class="num {{ 'rem'   if removed_n else 'zero' }}">{{ removed_n }}</td>
        <td class="num {{ 'mod'   if mod_n     else 'zero' }}">{{ mod_n }}</td>
        <td class="num {{ 'shift' if shift_n   else 'zero' }}">{{ shift_n }}</td>
      </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr>
        <td class="tech" colspan="4"><b>Total</b></td>
        <td class="num {{ 'add'   if totals.add   else 'zero' }}">{{ totals.add }}</td>
        <td class="num {{ 'rem'   if totals.rem   else 'zero' }}">{{ totals.rem }}</td>
        <td class="num {{ 'mod'   if totals.mod   else 'zero' }}">{{ totals.mod }}</td>
        <td class="num {{ 'shift' if totals.shift else 'zero' }}">{{ totals.shift }}</td>
      </tr>
    </tfoot>
  </table>
  </div>
</div>

<!-- Section 2: Required changes by FBDI file, grouped by module -->
{% if ctx.file_sections %}
<div class="section">
  <h2>2. Required changes</h2>
  <div class="lede">Grouped by Applaud module. For each tab: Added, Removed, Modified, Renamed, Shifted.</div>

  <div class="sticky-controls">
    <div class="legend">
      <span class="legend-eyebrow">Legend</span>
      <span class="legend-item"><span class="pdf-action">&#9679;</span>&nbsp;Add</span>
      <span class="legend-item"><span class="pdf-action pdf-del">&#9679;</span>&nbsp;Remove</span>
      <span class="legend-item"><span class="pdf-action pdf-warn">&#9679;</span>&nbsp;Modify</span>
      <span class="legend-item"><span class="pdf-action pdf-shift">&#9679;</span>&nbsp;Shift</span>
      <span class="legend-item"><span class="pdf-action pdf-dash">&#9675;</span>&nbsp;Rename</span>
      <span class="legend-divider"></span>
      <span class="legend-item"><b>DB</b>&nbsp;Database</span>
      <span class="legend-item"><b>IF</b>&nbsp;Import&nbsp;form</span>
      <span class="legend-item"><b>EF</b>&nbsp;Export&nbsp;form</span>
    </div>
    {% if not print_mode %}
    <div class="change-filter" id="change-filter" role="group" aria-label="Filter by change type">
      <span class="change-filter-eyebrow">Show</span>
      <label class="change-filter-option"><input type="checkbox" class="cf-check" data-type="added" checked> <span class="cf-label added">Added</span></label>
      <label class="change-filter-option"><input type="checkbox" class="cf-check" data-type="removed" checked> <span class="cf-label removed">Removed</span></label>
      <label class="change-filter-option"><input type="checkbox" class="cf-check" data-type="modified" checked> <span class="cf-label modified">Modified</span></label>
      <label class="change-filter-option"><input type="checkbox" class="cf-check" data-type="shifted" checked> <span class="cf-label shifted">Shifted</span></label>
    </div>
    {% endif %}
  </div>

  <div role="note" class="required-note">Required status in Added tables reflects Oracle catalog data — validate against the live Oracle instance before treating as authoritative.</div>

  {% set grouped = ctx.file_sections | groupby('module') | list %}
  {% if grouped | length > 1 %}
  <nav class="module-jump" aria-label="Jump to module">
    <span class="module-jump-eyebrow">Jump to{% if not print_mode %} &nbsp;·&nbsp; <kbd style="font-size:var(--type-label);padding:1px 4px;border:1px solid var(--coolgray);border-radius:var(--radius-xs);background:var(--bg-soft);font-family:inherit;">J</kbd>/<kbd style="font-size:var(--type-label);padding:1px 4px;border:1px solid var(--coolgray);border-radius:var(--radius-xs);background:var(--bg-soft);font-family:inherit;">K</kbd> prev/next{% endif %}</span>
    {% for g in grouped %}<a href="#module-{{ (g.grouper or 'unknown') | replace(' ', '-') | replace('&', 'and') | lower }}" aria-label="Jump to module: {{ g.grouper or 'Unknown' }}">{{ g.grouper or 'Unknown' }}</a>{% endfor %}
  </nav>
  {% endif %}

  {% for g in grouped %}
  {% set module = g.grouper %}
  {% set sections_in_module = g.list %}
  {% set module_slug = (module or 'unknown') | replace(' ', '-') | replace('&', 'and') | lower %}
  <div class="module-group" id="module-{{ module_slug }}">
    <div class="module-header">
      <span class="module-eyebrow">Module</span>
      <h3 class="module-name">{{ module or 'Unknown' }}</h3>
    </div>

    {% for s in sections_in_module %}
    {% set file_id = s.file ~ '-' ~ s.prefix %}
    <div class="file-section" id="file-{{ file_id }}">
    <div class="file-head">
      <div class="file-name">{{ s.file }}{% if s.status == 'NEEDS_REVIEW' %} <span class="needs-review-badge">&#9888; Needs review</span>{% endif %}</div>
      <div class="meta">
        <span><b>FBDI Tab:</b> {{ s.tab }}</span>
        <span><b>Applaud Table:</b> {{ s.applaud_table }}</span>
        <span><b>Prefix:</b> <code>{{ s.prefix }}</code></span>
      </div>
    </div>
    <div class="file-body">

      {% if s.in_base_note %}
      <div class="in-base-note"><b>Note:</b> {{ s.in_base_note }}</div>
      {% endif %}

      {% if s.changes_by_type.get('ADDED') %}
      <div class="change-block added">
        <h4>Added <span class="count">{{ s.changes_by_type['ADDED'] | length }}</span></h4>
        <table class="ct">
          <thead>
            <tr>
              <th scope="col">Applaud Field</th>
              <th class="num" scope="col">Pos</th>
              <th scope="col">Oracle Type</th>
              <th scope="col">Applaud Type</th>
              <th class="center" scope="col">Required</th>
              <th class="action-col" scope="col" title="Database">DB</th>
              <th class="action-col" scope="col" title="Import Form">IF</th>
              <th class="action-col" scope="col" title="Export Form">EF</th>
            </tr>
          </thead>
          <tbody>
            {% for r in s.changes_by_type['ADDED'] %}
            <tr>
              <td class="field">{{ r.applaud_field_name }}{% if r.name_exceeds_30 %} <span class="badge warn-text" title="Exceeds 30 char limit">&#9888; {{ r.name_length }} chars</span>{% endif %}</td>
              <td class="num">{{ r.new_position }}</td>
              <td>{{ r.oracle_type_str }}</td>
              <td>{{ r.applaud_type_str }}</td>
              <td class="center">{% if r.required is true %}TRUE{% elif r.required is false %}FALSE{% else %}—{% endif %}</td>
              <td class="action-col">{% if print_mode %}<span class="pdf-action">●</span>{% else %}<input type="checkbox" class="action-check" data-key="{{ file_id }}|ADDED|{{ r.applaud_field_name }}|DB" aria-label="{{ r.applaud_field_name }}: add database column" title="Add DB column">{% endif %}</td>
              <td class="action-col">{% if print_mode %}<span class="pdf-action">●</span>{% else %}<input type="checkbox" class="action-check" data-key="{{ file_id }}|ADDED|{{ r.applaud_field_name }}|IF" aria-label="{{ r.applaud_field_name }}: add to import form" title="Add field to Import Form">{% endif %}</td>
              <td class="action-col">{% if print_mode %}<span class="pdf-action">●</span>{% else %}<input type="checkbox" class="action-check" data-key="{{ file_id }}|ADDED|{{ r.applaud_field_name }}|EF" aria-label="{{ r.applaud_field_name }}: add to export form" title="Add field to Export Form">{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      {% if s.changes_by_type.get('REMOVED') %}
      <div class="change-block removed">
        <h4>Removed <span class="count">{{ s.changes_by_type['REMOVED'] | length }}</span></h4>
        <table class="ct">
          <thead>
            <tr>
              <th>Applaud Field</th>
              <th class="num">Was at Pos</th>
              <th>Oracle Type</th>
              <th>Applaud Type</th>
              <th class="action-col" title="Database">DB</th>
              <th class="action-col" title="Import Form">IF</th>
              <th class="action-col" title="Export Form">EF</th>
            </tr>
          </thead>
          <tbody>
            {% for r in s.changes_by_type['REMOVED'] %}
            <tr>
              <td class="field">{{ r.applaud_field_name }}</td>
              <td class="num">{{ r.old_position }}</td>
              <td>{{ r.oracle_type_str }}</td>
              <td>{{ r.applaud_type_str }}</td>
              <td class="action-col">{% if print_mode %}<span class="pdf-action pdf-del">●</span>{% else %}<input type="checkbox" class="action-check del" data-key="{{ file_id }}|REMOVED|{{ r.applaud_field_name }}|DB" aria-label="{{ r.applaud_field_name }}: drop database column" title="Drop DB column">{% endif %}</td>
              <td class="action-col">{% if print_mode %}<span class="pdf-action pdf-del">●</span>{% else %}<input type="checkbox" class="action-check del" data-key="{{ file_id }}|REMOVED|{{ r.applaud_field_name }}|IF" aria-label="{{ r.applaud_field_name }}: remove from import form" title="Remove from Import Form">{% endif %}</td>
              <td class="action-col">{% if print_mode %}<span class="pdf-action pdf-del">●</span>{% else %}<input type="checkbox" class="action-check del" data-key="{{ file_id }}|REMOVED|{{ r.applaud_field_name }}|EF" aria-label="{{ r.applaud_field_name }}: remove from export form" title="Remove from Export Form">{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      {% if s.changes_by_type.get('MODIFIED') %}
      <div class="change-block modified">
        <h4>Modified <span class="count">{{ s.changes_by_type['MODIFIED'] | length }}</span></h4>
        <table class="ct">
          <thead>
            <tr>
              <th>Applaud Field</th>
              <th class="num">Pos</th>
              <th>Change</th>
              <th class="action-col" title="Database">DB</th>
              <th class="action-col" title="Import Form">IF</th>
              <th class="action-col" title="Export Form">EF</th>
            </tr>
          </thead>
          <tbody>
            {% for r in s.changes_by_type['MODIFIED'] %}
            {% set has_type_change = ('type' in r.sub_kinds) or ('length' in r.sub_kinds) or ('scale' in r.sub_kinds) %}
            {% set has_required_change = 'required' in r.sub_kinds %}
            <tr>
              <td class="field">{{ r.applaud_field_name }}</td>
              <td class="num">{{ r.new_position }}</td>
              <td>
                {% if has_type_change %}Type: <span class="type-old">{{ r.old_oracle_type_str }}</span><span class="type-arrow">&rarr;</span><span class="type-new">{{ r.new_oracle_type_str }}</span>{% endif %}
                {% if has_type_change and has_required_change %}<br>{% endif %}
                {% if has_required_change %}Required: <span class="type-old">{% if r.old_required is true %}TRUE{% elif r.old_required is false %}FALSE{% else %}—{% endif %}</span><span class="type-arrow">&rarr;</span><span class="type-new">{% if r.new_required is true %}TRUE{% elif r.new_required is false %}FALSE{% else %}—{% endif %}</span> <span class="badge warn-text">flag only</span>{% endif %}
              </td>
              <td class="action-col">{% if print_mode %}<span class="pdf-action pdf-warn">●</span>{% else %}<input type="checkbox" class="action-check warn" data-key="{{ file_id }}|MODIFIED|{{ r.applaud_field_name }}|DB" aria-label="{{ r.applaud_field_name }}: alter database column" title="Alter DB column">{% endif %}</td>
              {% if has_required_change and not has_type_change %}
              <td class="action-col dim"><span class="dash-cell">&mdash;</span></td>
              <td class="action-col dim"><span class="dash-cell">&mdash;</span></td>
              {% else %}
              <td class="action-col">{% if print_mode %}<span class="pdf-action pdf-warn">●</span>{% else %}<input type="checkbox" class="action-check warn" data-key="{{ file_id }}|MODIFIED|{{ r.applaud_field_name }}|IF" aria-label="{{ r.applaud_field_name }}: update import form field" title="Update Import Form field">{% endif %}</td>
              <td class="action-col">{% if print_mode %}<span class="pdf-action pdf-warn">●</span>{% else %}<input type="checkbox" class="action-check warn" data-key="{{ file_id }}|MODIFIED|{{ r.applaud_field_name }}|EF" aria-label="{{ r.applaud_field_name }}: update export form field" title="Update Export Form field">{% endif %}</td>
              {% endif %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      {% if s.changes_by_type.get('RENAMED') %}
      <div class="change-block renamed">
        <h4>Renamed <span class="count">{{ s.changes_by_type['RENAMED'] | length }}</span></h4>
        <table class="ct">
          <thead>
            <tr>
              <th>Applaud Field</th>
              <th class="num">Pos</th>
              <th>Label change</th>
              <th class="action-col" title="Database">DB</th>
              <th class="action-col" title="Import Form">IF</th>
              <th class="action-col" title="Export Form">EF</th>
            </tr>
          </thead>
          <tbody>
            {% for r in s.changes_by_type['RENAMED'] %}
            <tr>
              <td class="field">{{ r.applaud_field_name }}</td>
              <td class="num">{{ r.new_position }}</td>
              <td><span class="type-old">"{{ r.old_label }}"</span><span class="type-arrow">&rarr;</span><span class="type-new">"{{ r.new_label }}"</span></td>
              <td class="action-col">{% if print_mode %}<span class="pdf-action pdf-dash">○</span>{% else %}<input type="checkbox" class="action-check dash" data-key="{{ file_id }}|RENAMED|{{ r.applaud_field_name }}|DB" aria-label="{{ r.applaud_field_name }}: update database description (optional)" title="Optional: update DB description">{% endif %}</td>
              <td class="action-col dim"><span class="dash-cell">&mdash;</span></td>
              <td class="action-col dim"><span class="dash-cell">&mdash;</span></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        <div class="renamed-note">Renamed labels are low priority. The DB data element description in Applaud may be updated; no IF or EF action is required.</div>
      </div>
      {% endif %}

      {% if s.changes_by_type.get('SHIFTED') %}
      <div class="change-block shifted">
        <h4>Shifted <span class="count">{{ s.changes_by_type['SHIFTED'] | length }}</span></h4>
        <div class="summary-box">{{ s.shift_summary }}</div>
        <div class="renamed-note">Position shifts are informational — no DB or form action is required unless Oracle has explicitly changed a column dependency.</div>
        {% if print_mode %}
        <div class="shift-grid">
          {% for r in s.changes_by_type['SHIFTED'] %}
          <div class="row"><span class="field-name">{{ r.applaud_field_name }}</span><span class="pos-pair"><span class="old-pos">{{ r.old_position }}</span> <span class="arrow">&rarr;</span> <span class="new-pos">{{ r.new_position }}</span></span></div>
          {% endfor %}
        </div>
        {% else %}
        <details class="shift-details">
          <summary>Show all {{ s.changes_by_type['SHIFTED'] | length }} shifted fields</summary>
          <div>
            <div class="shift-grid">
              {% for r in s.changes_by_type['SHIFTED'] %}
              <div class="row"><span class="field-name">{{ r.applaud_field_name }}</span><span class="pos-pair"><span class="old-pos">{{ r.old_position }}</span> <span class="arrow">&rarr;</span> <span class="new-pos">{{ r.new_position }}</span></span></div>
              {% endfor %}
            </div>
          </div>
        </details>
        {% endif %}
      </div>
      {% endif %}

      {% if s.changes_by_type.get('MULTI') %}
      <div class="change-block modified">
        <h4>Combined changes <span class="count">{{ s.changes_by_type['MULTI'] | length }}</span></h4>
        <table class="ct">
          <thead>
            <tr>
              <th>Applaud Field</th>
              <th class="num">Was</th>
              <th class="num">Now</th>
              <th>Axes Changed</th>
              <th class="action-col" title="Database">DB</th>
              <th class="action-col" title="Import Form">IF</th>
              <th class="action-col" title="Export Form">EF</th>
            </tr>
          </thead>
          <tbody>
            {% for r in s.changes_by_type['MULTI'] %}
            <tr>
              <td class="field">{{ r.applaud_field_name }}</td>
              <td class="num">{% if r.old_position is not none %}{{ r.old_position }}{% else %}&mdash;{% endif %}</td>
              <td class="num">{% if r.new_position is not none %}{{ r.new_position }}{% else %}&mdash;{% endif %}</td>
              <td>{{ r.axes | join(', ') }}{% if r.sub_kinds %} ({{ r.sub_kinds | join(', ') }}){% endif %}</td>
              <td class="action-col">{% if print_mode %}<span class="pdf-action pdf-warn">●</span>{% else %}<input type="checkbox" class="action-check warn" data-key="{{ file_id }}|MULTI|{{ r.applaud_field_name }}|DB" aria-label="{{ r.applaud_field_name }}: update database column" title="Update DB column">{% endif %}</td>
              <td class="action-col">{% if print_mode %}<span class="pdf-action pdf-warn">●</span>{% else %}<input type="checkbox" class="action-check warn" data-key="{{ file_id }}|MULTI|{{ r.applaud_field_name }}|IF" aria-label="{{ r.applaud_field_name }}: update import form field" title="Update Import Form field">{% endif %}</td>
              <td class="action-col">{% if print_mode %}<span class="pdf-action pdf-warn">●</span>{% else %}<input type="checkbox" class="action-check warn" data-key="{{ file_id }}|MULTI|{{ r.applaud_field_name }}|EF" aria-label="{{ r.applaud_field_name }}: update export form field" title="Update Export Form field">{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        <div class="renamed-note">Combined changes have multiple simultaneous axes — review each action column individually and apply all that are relevant.</div>
      </div>
      {% endif %}

    </div>
  </div>
    {% endfor %}
  </div>
  {% endfor %}
</div>
{% endif %}

<!-- Section 3: Pending base-system tables -->
{% if ctx.pending_base %}
<div class="section">
  <h2>3. Pending base-system tables</h2>
  <div class="lede">FBDI tabs mapped to an Applaud target table not yet present in the standard base install. Listed for the platform team's visibility; not actionable for client-install consultants.</div>
  <ul class="pending-list">
    {% for p in ctx.pending_base %}
    <li>
      <span class="name"><code class="file-id">{{ p.file }}</code> &middot; {{ p.tab }} &rarr; <code>{{ p.applaud_table }}</code> &middot; <code>{{ p.prefix }}</code> <span class="module-tag">{{ p.module }}</span></span>
      <span class="pending-count">{{ p.change_count }} change{% if p.change_count != 1 %}s{% endif %} pending</span>
    </li>
    {% endfor %}
  </ul>
  <div class="pending-footnote">For full per-field detail on pending-base tables, see <code>FBDI_Master_Catalog.xlsx</code> &middot; Drift sheet.</div>
</div>
{% endif %}

{% if not print_mode %}
<script>
/* Action-checkbox persistence (HTML only).
   Key shape: fbdi-report:{old}-{new}:{file-id}|{change_type}|{field_name}|{action}
   Content-keyed (not index-keyed) so persistence survives row count or order
   changes between releases — adding a new ADDED field next quarter doesn't
   shift other rows' state onto the wrong checkbox.

   On load, prune any keys for release pairs other than the current one to
   prevent indefinite localStorage growth across quarters. */
(function () {
  var ROOT = 'fbdi-report:';
  var pair = '{{ ctx.old_release }}-{{ ctx.new_release }}';
  var prefix = ROOT + pair + ':';

  // Auto-prune: drop any fbdi-report keys from release pairs that aren't current.
  try {
    for (var i = localStorage.length - 1; i >= 0; i--) {
      var k = localStorage.key(i);
      if (k && k.indexOf(ROOT) === 0 && k.indexOf(prefix) !== 0) {
        localStorage.removeItem(k);
      }
    }
  } catch (e) { /* localStorage may be disabled */ }

  var allBoxes = document.querySelectorAll('input.action-check[data-key]');
  allBoxes.forEach(function (cb) {
    var key = prefix + cb.dataset.key;
    try {
      if (localStorage.getItem(key) === '1') cb.checked = true;
    } catch (e) { /* swallow */ }
    cb.addEventListener('change', function () {
      try {
        if (cb.checked) localStorage.setItem(key, '1');
        else localStorage.removeItem(key);
      } catch (e) { /* swallow quota errors */ }
      updateProgress();
    });
  });

  // Progress meter — counts checked vs total action-checkboxes.
  var doneEl  = document.getElementById('progress-done');
  var totalEl = document.getElementById('progress-total');
  var fillEl  = document.getElementById('progress-fill');
  var pctEl   = document.getElementById('progress-pct');
  var meter   = document.getElementById('progress-meter');
  function updateProgress() {
    var total = allBoxes.length;
    var done = 0;
    allBoxes.forEach(function (cb) { if (cb.checked) done++; });
    var pct = total === 0 ? 0 : Math.round(done / total * 100);
    if (doneEl)  doneEl.textContent = done;
    if (totalEl) totalEl.textContent = total;
    if (pctEl)   pctEl.textContent = pct;
    if (fillEl)  fillEl.style.transform = 'scaleX(' + (pct / 100) + ')';
    if (meter)   meter.classList.toggle('complete', done === total && total > 0);
  }
  updateProgress();

  // Export state — downloads a JSON of all checked keys for this release pair.
  var exportLink = document.getElementById('export-state-link');
  if (exportLink) {
    exportLink.addEventListener('click', function (e) {
      e.preventDefault();
      var state = {};
      try {
        for (var i = 0; i < localStorage.length; i++) {
          var k = localStorage.key(i);
          if (k && k.indexOf(prefix) === 0) state[k.substring(prefix.length)] = '1';
        }
      } catch (e2) {}
      var blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'fbdi-state-{{ ctx.old_release }}-{{ ctx.new_release }}.json';
      a.click();
      setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
    });
  }

  // Change-type filter bar — toggles visibility of change-block divs by type.
  var filterChecks = document.querySelectorAll('.cf-check');
  function applyFilter() {
    var show = {};
    filterChecks.forEach(function (cb) { show[cb.dataset.type] = cb.checked; });
    document.querySelectorAll('.change-block').forEach(function (block) {
      var type = block.classList.contains('removed') ? 'removed' :
                 block.classList.contains('shifted')  ? 'shifted'  :
                 block.classList.contains('modified')  ? 'modified'  :
                 block.classList.contains('added')     ? 'added'     : null;
      if (type !== null) block.style.display = show[type] === false ? 'none' : '';
    });
    // Collapse empty file-sections and module-groups from view.
    document.querySelectorAll('.file-section').forEach(function (sec) {
      var visible = Array.from(sec.querySelectorAll('.change-block')).some(function (b) { return b.style.display !== 'none'; });
      sec.style.display = visible ? '' : 'none';
    });
    document.querySelectorAll('.module-group').forEach(function (grp) {
      var visible = Array.from(grp.querySelectorAll('.file-section')).some(function (s) { return s.style.display !== 'none'; });
      grp.style.display = visible ? '' : 'none';
    });
  }
  filterChecks.forEach(function (cb) { cb.addEventListener('change', applyFilter); });

  // J / K keyboard navigation — jump between visible file-sections.
  document.addEventListener('keydown', function (e) {
    if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
    if (e.key !== 'j' && e.key !== 'k') return;
    var sections = Array.from(document.querySelectorAll('.file-section')).filter(function (s) { return s.style.display !== 'none'; });
    if (!sections.length) return;
    var scrollY = window.scrollY + window.innerHeight / 3;
    var cur = -1;
    sections.forEach(function (s, i) { if (s.getBoundingClientRect().top + window.scrollY <= scrollY) cur = i; });
    var next = e.key === 'j' ? Math.min(cur + 1, sections.length - 1) : Math.max(cur - 1, 0);
    sections[next].scrollIntoView({ behavior: 'smooth', block: 'start' });
    e.preventDefault();
  });
})();
</script>
{% endif %}
</body>
</html>
